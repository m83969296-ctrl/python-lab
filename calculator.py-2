import random

def choose_word():
    """Pick a random word from the list."""
    words = [
        "python", "neural", "tensor", "engine", "coding",
        "future", "rocket", "matrix", "binary", "network"
    ]
    return random.choice(words)

def show_word(word, guessed_letters):
    """Show the word with guessed letters revealed."""
    display = ""
    for letter in word:
        if letter in guessed_letters:
            display += letter + " "
        else:
            display += "_ "
    return display.strip()

def hangman():
    print("=" * 40)
    print("   WELCOME TO HANGMAN GAME")
    print("=" * 40)
    
    word = choose_word()
    guessed_letters = []
    wrong_guesses = 0
    max_wrong = 6
    
    print(f"\nI'm thinking of a word with {len(word)} letters.")
    print(f"You have {max_wrong} chances.\n")
    
    while wrong_guesses < max_wrong:
        print(f"Word: {show_word(word, guessed_letters)}")
        print(f"Wrong guesses: {wrong_guesses}/{max_wrong}")
        
        if guessed_letters:
            print(f"Guessed letters: {', '.join(guessed_letters)}")
        
        # Check if player won
        if all(letter in guessed_letters for letter in word):
            print(f"\nCongratulations! You guessed the word: {word}")
            print("You win!")
            return
        
        # Get input
        guess = input("\nGuess a letter: ").lower().strip()
        
        # Validate input
        if len(guess) != 1:
            print("Please enter only ONE letter.\n")
            continue
        
        if not guess.isalpha():
            print("Please enter a LETTER, not a number.\n")
            continue
        
        if guess in guessed_letters:
            print(f"You already guessed '{guess}'. Try another.\n")
            continue
        
        guessed_letters.append(guess)
        
        if guess in word:
            print(f"Good! '{guess}' is in the word.\n")
        else:
            wrong_guesses += 1
            print(f"Sorry, '{guess}' is not in the word.\n")
    
    # Player lost
    print(f"\nGame over! The word was: {word}")
    print("Better luck next time.")

def main():
    while True:
        hangman()
        again = input("\nPlay again? (y/n): ").lower().strip()
        if again != "y":
            print("Thanks for playing!")
            break

main()